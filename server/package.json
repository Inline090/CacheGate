{
  "name": "@cachegate/server",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP caching proxy server with Redis cache and PostgreSQL analytics",
  "main": "src/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "test": "node --test"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  }
}
