# Port the proxy listens on
PORT=3000

# Server the proxy forwards requests to
ORIGIN=http://localhost:8080

# Redis connection, matches docker-compose.yml
REDIS_URL=redis://localhost:6379

# How long a cached response stays valid, in seconds
CACHE_TTL=60

# Postgres connection used for request stats, matches docker-compose.yml
DATABASE_URL=postgres://cachegate:cachegate@localhost:5433/cachegate
